# Decent Cloud secret template (NO real values — operator fills, then encrypts).
#
# This repo uses AGE-SOPS for its own `secrets/`; the nuc-k3s cluster uses
# PGP-SOPS. The REAL secret applied to the cluster lives in the nuc-k3s repo
# (see ../nuc-k3s/decent-cloud-secret.yaml). This file documents every key the
# manifests in decent-cloud.yaml reference, so operators know what to fill.
#
# Env name -> secret key mapping (the `key:` here matches the
# `secretKeyRef.key` in deploy/k8s/decent-cloud.yaml):
#
#   DATABASE_URL (api,api-sync)              -> API_DATABASE_URL
#   POSTGRES_PASSWORD (chatwoot-*)           -> CHATWOOT_POSTGRES_PASSWORD
#   SECRET_KEY_BASE (chatwoot-*)             -> CHATWOOT_SECRET_KEY_BASE
#   CHATWOOT_INBOX_HMAC_SECRET_KEY (chatwoot)-> CHATWOOT_HMAC_SECRET
#   TUNNEL_TOKEN (cloudflared)               -> TUNNEL_TOKEN_PROD
#   every other env var maps 1:1 to a key of the same name.
apiVersion: v1
kind: Secret
metadata:
  name: decent-cloud-secret
  namespace: apps
type: Opaque
stringData:
  # ---- API / central DB (host Postgres 192.168.0.2:5432, DB decent_cloud_prod)
  # postgres://<user>:<pw>@192.168.0.2:5432/decent_cloud_prod
  API_DATABASE_URL: postgres://decent_cloud_prod:REPLACE@192.168.0.2:5432/decent_cloud_prod
  CREDENTIAL_ENCRYPTION_KEY: REPLACE_WITH_32_BYTE_HEX  # openssl rand -hex 32

  # ---- Cloudflare DNS (gateway record management) + tunnel
  CF_API_TOKEN: REPLACE_WITH_CLOUDFLARE_API_TOKEN
  CF_ZONE_ID: REPLACE_WITH_CLOUDFLARE_ZONE_ID
  TUNNEL_TOKEN_PROD: REPLACE_WITH_CONNECTOR_TOKEN  # generate+rotate: see TUNNEL.md (cf/tunnel.py prod)

  # ---- Stripe payments
  STRIPE_SECRET_KEY: REPLACE_WITH_STRIPE_SECRET_KEY
  STRIPE_PUBLISHABLE_KEY: REPLACE_WITH_STRIPE_PUBLISHABLE_KEY
  STRIPE_WEBHOOK_SECRET: REPLACE_WITH_STRIPE_WEBHOOK_SECRET
  INVOICE_SELLER_IBAN: ""  # optional

  # ---- Google OAuth
  GOOGLE_OAUTH_CLIENT_ID: REPLACE_WITH_GOOGLE_OAUTH_CLIENT_ID
  GOOGLE_OAUTH_CLIENT_SECRET: REPLACE_WITH_GOOGLE_OAUTH_CLIENT_SECRET
  GOOGLE_OAUTH_REDIRECT_URL: https://decent-cloud.org/auth/callback

  # ---- Frontend / public URL
  FRONTEND_URL: https://decent-cloud.org

  # ---- Email (MailChannels + DKIM)
  MAILCHANNELS_API_KEY: REPLACE_WITH_MAILCHANNELS_API_KEY
  DKIM_DOMAIN: decent-cloud.org
  DKIM_SELECTOR: REPLACE_WITH_DKIM_SELECTOR
  DKIM_PRIVATE_KEY: REPLACE_WITH_BASE64_DKIM_PRIVATE_KEY

  # ---- Chatwoot integration
  CHATWOOT_API_TOKEN: REPLACE_WITH_CHATWOOT_API_TOKEN
  CHATWOOT_PLATFORM_API_TOKEN: REPLACE_WITH_CHATWOOT_PLATFORM_API_TOKEN
  CHATWOOT_HMAC_SECRET: REPLACE_WITH_32_BYTE_HEX  # openssl rand -hex 32

  # ---- Chatwoot DB (host Postgres 192.168.0.2:5432, DB chatwoot_prod)
  CHATWOOT_POSTGRES_PASSWORD: REPLACE_WITH_CHATWOOT_PROD_DB_PASSWORD
  CHATWOOT_SECRET_KEY_BASE: REPLACE_WITH_64_BYTE_HEX  # openssl rand -hex 64
  SMTP_ADDRESS: 192.168.0.2
  SMTP_USERNAME: REPLACE_WITH_SMTP_USERNAME
  SMTP_PASSWORD: REPLACE_WITH_SMTP_PASSWORD
  OPENAI_API_KEY: ""  # optional (Chatwoot AI features)

  # ---- Notifications
  DEFAULT_ESCALATION_USER: ""  # optional
  TELEGRAM_BOT_TOKEN: REPLACE_WITH_TELEGRAM_BOT_TOKEN
  TEXTBEE_DEVICE_ID: ""  # optional
  TEXTBEE_API_KEY: ""  # optional
  TEXTBEE_API_URL: ""  # optional
  TWILIO_ACCOUNT_SID: ""  # optional
  TWILIO_AUTH_TOKEN: ""  # optional
  TWILIO_PHONE_NUMBER: ""  # optional

  # ---- AI Bot (answer generation + recipe review)
  LLM_API_KEY: REPLACE_WITH_LLM_API_KEY
  LLM_API_URL: https://api.anthropic.com
  LLM_API_MODEL: claude-sonnet-4-5-20250514
