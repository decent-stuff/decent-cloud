#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# dependencies = ["pyyaml"]
# ///
"""dc-secrets: credential store using SOPS (age backend) with flock concurrency.

Single source of truth for all credentials. SOPS files are git-committable
(keys visible, values encrypted). Designed for multi-agent Docker environments.

Behavioural spec: 1:1 port of the previous bash implementation. Output formats,
env-var resolution, file layout and error messages are preserved verbatim because
callers (esp. ``eval "$(scripts/dc-secrets export)"``) depend on them. Values are
encoded/decoded with pyyaml instead of hand-rolled escaping so that values
containing ``://``, ``@``, quotes, spaces and backslashes round-trip byte-identical.
"""
from __future__ import annotations

import fcntl
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path

import yaml

# ─── Paths & globals ───────────────────────────────────────────────────────────
SECRETS_DIR = os.environ.get("DC_SECRETS_DIR") or str(Path(__file__).resolve().parent.parent / "secrets")
IDENTITY_FILE = os.path.join(SECRETS_DIR, ".age-identity")
SOPS_CONFIG = os.path.join(SECRETS_DIR, ".sops.yaml")
LOCKS_DIR = os.path.join(SECRETS_DIR, ".locks")

_LOCK_TIMEOUT = 10  # seconds, mirrors `flock -w 10`


def die(msg: str) -> None:
    """Print a prefixed error to stderr and exit 1 (mirrors bash die())."""
    print(f"dc-secrets: error: {msg}", file=sys.stderr)
    sys.exit(1)


# ─── age key resolution ────────────────────────────────────────────────────────
# Resolve the SOPS age key from the first available source, in priority order:
#   1. SOPS_AGE_KEY          inline key material (CI / secret manager). SOPS reads
#                            this natively — no identity file needed.
#   2. SOPS_AGE_KEY_FILE     explicit path (e.g. a host bind-mount in a sandbox).
#   3. $IDENTITY_FILE        repo-local bootstrap file (generated by `init`).
# A fresh clone/sandbox ships encrypted SOPS files but NO key; it must receive the
# canonical age key via (1) or (2). See agent/docs/secrets.md.
def resolve_age_key():
    """Return ``(source, env_updates)`` or ``None``.

    ``env_updates`` maps subprocess env vars to their value; a value of ``None``
    means "unset this var" (so SOPS falls back to the inline key).
    """
    inline = os.environ.get("SOPS_AGE_KEY")
    if inline:
        # SOPS reads SOPS_AGE_KEY natively; ensure SOPS_AGE_KEY_FILE is unset so it
        # does not override the inline key.
        return ("env:SOPS_AGE_KEY", {"SOPS_AGE_KEY": inline, "SOPS_AGE_KEY_FILE": None})
    key_file = os.environ.get("SOPS_AGE_KEY_FILE")
    if key_file and os.path.isfile(key_file):
        return ("env:SOPS_AGE_KEY_FILE", {"SOPS_AGE_KEY_FILE": key_file})
    if os.path.isfile(IDENTITY_FILE):
        return (f"file:{IDENTITY_FILE}", {"SOPS_AGE_KEY_FILE": IDENTITY_FILE})
    return None


def sops_env() -> dict:
    """Build the env dict a sops/age subprocess should inherit."""
    env = dict(os.environ)
    res = resolve_age_key()
    if res is not None:
        for key, value in res[1].items():
            if value is None:
                env.pop(key, None)
            else:
                env[key] = value
    return env


def derive_pubkey(identity_file: str | None = None) -> str | None:
    """Derive the age public key (recipient) from the resolved identity.

    Works for both the bare secret (SOPS_AGE_KEY) and a full identity file. When
    ``identity_file`` is given it is used directly (post-init/import).
    """
    env = dict(os.environ)
    if identity_file is None:
        # Standard resolution priority.
        inline = os.environ.get("SOPS_AGE_KEY")
        if inline:
            res = subprocess.run(
                ["age-keygen", "-y"], input=inline + "\n", capture_output=True, text=True, env=env
            )
            return res.stdout.strip() if res.returncode == 0 else None
        key_file = os.environ.get("SOPS_AGE_KEY_FILE")
        if key_file and os.path.isfile(key_file):
            identity_file = key_file
        elif os.path.isfile(IDENTITY_FILE):
            identity_file = IDENTITY_FILE
        else:
            return None
    if identity_file and os.path.isfile(identity_file):
        res = subprocess.run(["age-keygen", "-y", identity_file], capture_output=True, text=True, env=env)
        return res.stdout.strip() if res.returncode == 0 else None
    return None


def ensure_sops_config(identity_file: str | None = None) -> None:
    """Create $SOPS_CONFIG (idempotent) using the resolved identity's public key."""
    if os.path.isfile(SOPS_CONFIG):
        return
    pubkey = derive_pubkey(identity_file)
    if not pubkey:
        die("could not derive age public key for .sops.yaml")
    content = f"creation_rules:\n  - path_regex: \\.yaml$\n    age: {pubkey}\n"
    atomic_write(SOPS_CONFIG, content, mode=0o644)


def require_sops() -> None:
    if shutil.which("sops") is None:
        die("sops not found. Install: https://github.com/getsops/sops")
    if shutil.which("age") is None:
        die("age not found. Install: https://github.com/FiloSottile/age")


def require_init() -> None:
    if resolve_age_key() is None:
        die(
            "no SOPS age key found. Provide it via one of:\n"
            "  - SOPS_AGE_KEY env var        inline key material (best for CI / sandbox injection)\n"
            "  - SOPS_AGE_KEY_FILE env var   path to an age identity file (e.g. a host bind-mount)\n"
            f"  - {IDENTITY_FILE}              generated by 'dc-secrets init' on the bootstrap host\n"
            "A fresh sandbox receives the canonical key via env or a host bind-mount; see\n"
            "agent/docs/secrets.md. Without it the committed SOPS files cannot be decrypted."
        )
    if not os.path.isfile(SOPS_CONFIG):
        die(".sops.yaml missing. Run: dc-secrets init")


# ─── Path / lock helpers ───────────────────────────────────────────────────────
def resolve_path(logical: str) -> str:
    """Resolve a logical path (e.g. "shared/env") to a SOPS YAML file path."""
    directory = os.path.dirname(logical)
    base = os.path.basename(logical)
    if base.endswith(".yaml"):
        base = base[: -len(".yaml")]
    return os.path.join(SECRETS_DIR, directory, base + ".yaml")


def resolve_lock(logical: str) -> str:
    directory = os.path.dirname(logical) or "."
    base = os.path.basename(logical)
    lock_dir = os.path.join(LOCKS_DIR, directory)
    os.makedirs(lock_dir, exist_ok=True)
    return os.path.join(lock_dir, base + ".lock")


def acquire_lock(logical: str) -> int:
    """Acquire an exclusive flock on the per-logical lock file with a timeout."""
    lock_path = resolve_lock(logical)
    fd = os.open(lock_path, os.O_CREAT | os.O_RDWR, 0o600)
    deadline = time.monotonic() + _LOCK_TIMEOUT
    while True:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return fd
        except BlockingIOError:
            if time.monotonic() >= deadline:
                os.close(fd)
                die(f"could not acquire lock for {logical} (timeout 10s)")
            time.sleep(0.05)


# ─── YAML / SOPS helpers ───────────────────────────────────────────────────────
def atomic_write(path: str, content: str, mode: int = 0o600) -> None:
    """Write content to path atomically (temp + os.replace) with the given mode."""
    parent = os.path.dirname(path)
    if parent:
        os.makedirs(parent, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=parent or None)
    try:
        with os.fdopen(fd, "w") as fh:
            fh.write(content)
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)


def decrypt_dict(file_path: str) -> dict:
    """Decrypt a SOPS file to an ordered dict of key -> value.

    Returns ``{}`` only when the file does NOT yet exist (legitimate new-file
    creation). If the file EXISTS but ``sops -d`` fails, that is a corrupt or
    wrong-key store — die LOUD rather than silently returning empty (a silent
    empty return would let a subsequent ``set`` overwrite the file and destroy
    every other key). The sops metadata block is dropped defensively.
    """
    if not os.path.isfile(file_path):
        return {}
    res = subprocess.run(
        ["sops", "-d", file_path], capture_output=True, text=True, env=sops_env()
    )
    if res.returncode != 0:
        die(
            f"failed to decrypt {file_path} (sops exit {res.returncode}):\n"
            f"{res.stderr.strip()}\n"
            "The file is corrupt or was encrypted with a different age key than the one "
            "currently resolved. Aborting to prevent data loss — resolve the key/config "
            "(SOPS_AGE_KEY / SOPS_AGE_KEY_FILE / dc-secrets init) before retrying."
        )
    data = yaml.safe_load(res.stdout) or {}
    if isinstance(data, dict):
        data.pop("sops", None)  # defensive: sops -d already strips metadata
        return data
    return {}


def dict_to_yaml(data: dict) -> str:
    """Serialize a flat mapping to ``key: "value"`` YAML (double-quoted, ordered)."""
    return yaml.dump(
        data, default_style='"', allow_unicode=True, sort_keys=False, default_flow_style=False
    )


def encrypt_yaml(file_path: str, yaml_text: str) -> None:
    """Encrypt YAML plaintext into file_path via sops (atomic, mode 600)."""
    parent = os.path.dirname(file_path)
    if parent:
        os.makedirs(parent, exist_ok=True)
    fd, tmp = tempfile.mkstemp(suffix=".yaml", dir=parent or None)
    try:
        with os.fdopen(fd, "w") as fh:
            fh.write(yaml_text)
        res = subprocess.run(
            ["sops", "-e", "-i", "--config", SOPS_CONFIG, tmp],
            capture_output=True,
            text=True,
            env=sops_env(),
        )
        if res.returncode != 0:
            die(f"failed to encrypt {file_path}: {res.stderr.strip()}")
        os.replace(tmp, file_path)
        os.chmod(file_path, 0o600)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)


# ─── Commands ─────────────────────────────────────────────────────────────────
def cmd_init(args) -> None:
    require_sops()
    os.makedirs(os.path.join(SECRETS_DIR, "shared"), exist_ok=True)
    os.makedirs(os.path.join(SECRETS_DIR, "agents"), exist_ok=True)
    os.makedirs(os.path.join(SECRETS_DIR, "hires"), exist_ok=True)
    os.makedirs(LOCKS_DIR, exist_ok=True)

    # Footgun guard: if a portable age key is already available (env or host
    # bind-mount), ADOPT it instead of generating a competing local key — a fresh
    # key would be unable to decrypt the committed SOPS files (orphaning them).
    res = resolve_age_key()
    if res is not None:
        source = res[0]
        ensure_sops_config()
        print(f"Adopted existing age key ({source}) — no new key generated.")
        if os.path.isfile(SOPS_CONFIG):
            print(f"SOPS config: {SOPS_CONFIG}")
        return

    # Bootstrap (first-time-only, on the host): generate the canonical age key.
    res_gen = subprocess.run(["age-keygen", "-o", IDENTITY_FILE], capture_output=True, text=True)
    if res_gen.returncode != 0:
        die(f"failed to generate age key: {res_gen.stderr.strip()}")
    os.chmod(IDENTITY_FILE, 0o600)
    # Now that the repo identity exists, point resolution at it and write .sops.yaml.
    ensure_sops_config(IDENTITY_FILE)
    pubkey = derive_pubkey(IDENTITY_FILE)

    print(f"Initialized secrets store at {SECRETS_DIR}")
    print(f"Identity: {IDENTITY_FILE} (KEEP SECRET — do NOT commit)")
    print(f"Recipient: {pubkey}")
    print(f"SOPS config: {SOPS_CONFIG} (commit this)")
    print("")
    print("Make this key portable across sandboxes:")
    print("  dc-secrets age-key export > ~/.config/decent-cloud/age-identity")


def cmd_get(args) -> None:
    if len(args) < 2:
        die("usage: dc-secrets get <path> <key>")
    require_sops()
    require_init()
    logical, key = args[0], args[1]
    file = resolve_path(logical)
    if not os.path.isfile(file):
        die(f"secret file not found: {logical}")

    res = subprocess.run(
        ["sops", "-d", "--extract", f'["{key}"]', file],
        capture_output=True,
        text=True,
        env=sops_env(),
    )
    if res.returncode != 0:
        die(f"key not found: {key} in {logical}")
    # echo "$value": command-substitution strips trailing newlines, echo adds one.
    sys.stdout.write(res.stdout.rstrip("\n") + "\n")


def cmd_set(args) -> None:
    if len(args) < 2:
        die("usage: dc-secrets set <path> <key>=<value>")
    require_sops()
    require_init()
    logical = args[0]
    kvs = args[1:]
    file = resolve_path(logical)

    fd = acquire_lock(logical)
    try:
        data = decrypt_dict(file)  # ordered: insertion order preserved
        for kv in kvs:
            if "=" not in kv:
                die(f"invalid format: {kv} (expected key=value)")
            key, value = kv.split("=", 1)
            # Remove any existing entry with this key, then append (move to end).
            data.pop(key, None)
            data[key] = value
        encrypt_yaml(file, dict_to_yaml(data))
        print(f"wrote {os.path.abspath(file)} ({len(data)} keys)")
    finally:
        os.close(fd)


def cmd_delete(args) -> None:
    if len(args) < 2:
        die("usage: dc-secrets delete <path> <key>")
    require_sops()
    require_init()
    logical, key = args[0], args[1]
    file = resolve_path(logical)
    if not os.path.isfile(file):
        die(f"secret file not found: {logical}")

    fd = acquire_lock(logical)
    try:
        data = decrypt_dict(file)
        if key not in data:
            die(f"key not found: {key} in {logical}")
        data.pop(key)
        if not data:
            if os.path.isfile(file):
                os.remove(file)
                print(f"removed {key} from {os.path.abspath(file)} (file now empty, deleted)")
        else:
            encrypt_yaml(file, dict_to_yaml(data))
            print(f"wrote {os.path.abspath(file)} ({len(data)} keys)")
    finally:
        os.close(fd)


# Valid env-layer names for `export <env>`. ``common`` is always loaded first;
# ``play``/``dev``/``prod`` overlay it. A bare ``export`` (no env) is
# common-only — the structural fix for env leakage across stores.
EXPORT_ENVS = ("common", "play", "dev", "prod")


def cmd_export(args) -> None:
    require_sops()
    require_init()
    env: str | None = None
    agent: str | None = None
    i = 0
    while i < len(args):
        tok = args[i]
        if tok == "--agent":
            agent = args[i + 1] if i + 1 < len(args) else ""
            i += 2
        elif tok.startswith("--"):
            die(f"unknown flag: {tok}")
        elif env is None:
            env = tok  # optional positional ENV, expected before --agent
            i += 1
        else:
            die(f"unexpected argument: {tok}")

    if env is not None and env not in EXPORT_ENVS:
        die(
            f"unknown env layer '{env}' (expected one of: {', '.join(EXPORT_ENVS)}).\n"
            "Usage: dc-secrets export [<env>] [--agent <name>]  (bare export = common-only)"
        )

    # Build the ordered layer file list. Last file wins — a key present in both
    # common and the env layer is emitted twice, and a shell ``eval`` takes the
    # last occurrence (so the env-specific value wins). This preserves the
    # ``eval "$(dc-secrets export ...)"`` last-occurrence semantics callers
    # rely on, while making env selection EXPLICIT (no more leaking every
    # shared/*.yaml regardless of environment).
    shared_dir = os.path.join(SECRETS_DIR, "shared")
    common_file = os.path.join(shared_dir, "common.yaml")
    if not os.path.isfile(common_file):
        die("common layer 'shared/common.yaml' not found")
    layers = [common_file]
    if env and env != "common":
        env_file = os.path.join(shared_dir, f"{env}.yaml")
        if not os.path.isfile(env_file):
            die(
                f"env layer '{env}' not found at {env_file}; create it with: "
                f"dc-secrets set shared/{env} <KEY>=<value>"
            )
        layers.append(env_file)

    lines: list[str] = []
    for f in layers:
        for k, v in decrypt_dict(f).items():
            lines.append(f"{k}={v}")

    # Agent/hire overrides appended AFTER the shared layers, so the last
    # occurrence of a key is the agent-specific value (order: common → env →
    # agents → hires). Missing agent/hires files are NOT fatal.
    if agent:
        for sub in ("agents", "hires"):
            agent_file = os.path.join(SECRETS_DIR, sub, f"{agent}.yaml")
            if os.path.isfile(agent_file):
                for k, v in decrypt_dict(agent_file).items():
                    lines.append(f"{k}={v}")

    for line in lines:
        print(line)


def cmd_list(args) -> None:
    require_init()
    if not args:
        results = []
        for root, _dirs, files in os.walk(SECRETS_DIR):
            for fn in files:
                if not fn.endswith(".yaml") or fn == ".sops.yaml":
                    continue
                rel = os.path.relpath(os.path.join(root, fn), SECRETS_DIR)
                results.append(rel[: -len(".yaml")])
        for r in sorted(results):
            print(r)
    else:
        require_sops()
        logical = args[0]
        file = resolve_path(logical)
        if not os.path.isfile(file):
            die(f"secret file not found: {logical}")
        for k in decrypt_dict(file):
            print(k)


def _strip_env_quotes(value: str) -> str:
    """Strip surrounding quotes the way bash does (independently per quote char)."""
    if value.startswith('"'):
        value = value[1:]
    if value.endswith('"'):
        value = value[:-1]
    if value.startswith("'"):
        value = value[1:]
    if value.endswith("'"):
        value = value[:-1]
    return value


def cmd_import(args) -> None:
    if len(args) < 2:
        die("usage: dc-secrets import <env-file> <path>")
    require_sops()
    require_init()
    env_file, logical = args[0], args[1]
    if not os.path.isfile(env_file):
        die(f"file not found: {env_file}")

    file = resolve_path(logical)
    items: dict = {}
    with open(env_file) as fh:
        for raw in fh:
            line = raw.rstrip("\n")
            if line == "" or line.startswith("#"):
                continue
            if line.startswith("export "):
                line = line[len("export ") :]
            if "=" not in line:
                continue
            key, value = line.split("=", 1)
            items[key] = _strip_env_quotes(value)

    if not items:
        die(f"no key=value pairs found in {env_file}")

    fd = acquire_lock(logical)
    try:
        encrypt_yaml(file, dict_to_yaml(items))
    finally:
        os.close(fd)

    print(f"wrote {os.path.abspath(file)} ({len(items)} keys, imported from {env_file})")


def cmd_edit(args) -> None:
    if len(args) < 1:
        die("usage: dc-secrets edit <path>")
    require_sops()
    require_init()
    logical = args[0]
    file = resolve_path(logical)
    if not os.path.isfile(file):
        die(f"secret file not found: {logical} (create it first with 'set' or 'import')")
    # Interactive: inherit stdio so $EDITOR works.
    res = subprocess.run(["sops", file], env=sops_env())
    if res.returncode != 0:
        sys.exit(res.returncode)


def cmd_age_key(args) -> None:
    if not args:
        die("usage: dc-secrets age-key <export|import [--from <path>]>")
    sub = args[0]
    rest = args[1:]

    if sub == "export":
        # Print the resolved age identity (for backup / migration to a host).
        require_init()
        inline = os.environ.get("SOPS_AGE_KEY")
        key_file = os.environ.get("SOPS_AGE_KEY_FILE")
        if inline:
            sys.stdout.write(inline + "\n")
        elif key_file and os.path.isfile(key_file):
            sys.stdout.write(Path(key_file).read_text())
        elif os.path.isfile(IDENTITY_FILE):
            sys.stdout.write(Path(IDENTITY_FILE).read_text())
        else:
            die("no age key available to export")
        return

    if sub == "import":
        # Seed the repo-local identity from a host-provided key (fresh sandbox).
        from_path: str | None = None  # default: stdin
        i = 0
        while i < len(rest):
            if rest[i] == "--from":
                if i + 1 >= len(rest):
                    die("age-key import: --from requires a path")
                from_path = rest[i + 1]
                i += 2
            else:
                die(f"age-key import: unknown argument: {rest[i]}")
        require_sops()
        os.makedirs(SECRETS_DIR, exist_ok=True)
        if os.path.isfile(IDENTITY_FILE):
            die(
                f"{IDENTITY_FILE} already exists. To replace it, delete the file first "
                "(WARNING: this orphans files encrypted to the old key)."
            )
        if from_path is None or from_path == "-":
            data = sys.stdin.read()
        else:
            if not os.path.isfile(from_path):
                die(f"file not found: {from_path}")
            data = Path(from_path).read_text()
        # Validate it looks like an age identity before trusting it.
        if not re.search(r"^AGE-SECRET-KEY-1", data, re.MULTILINE):
            die("imported key is not a valid age identity (expected a line starting with AGE-SECRET-KEY-1)")
        atomic_write(IDENTITY_FILE, data, mode=0o600)
        # Derive recipient + write .sops.yaml (init's adoption path picks this up too).
        ensure_sops_config(IDENTITY_FILE)
        print(f"Imported age identity into {IDENTITY_FILE}")
        print(f"Recipient: {derive_pubkey(IDENTITY_FILE)}")
        return

    die("usage: dc-secrets age-key <export|import [--from <path>]>")


HELP_TEXT = """dc-secrets: credential store using SOPS (age encryption)

USAGE:
    dc-secrets <command> [args...]

COMMANDS:
    init                          Initialize store (generate age keypair + .sops.yaml),
                                   or ADOPT a portable key already provided via env/mount
    get    <path> <key>           Read a single credential
    set    <path> <key>=<value>   Write one or more credentials (flock-protected)
    delete <path> <key>           Remove a credential
    export [<env>] [--agent <n>]  Print creds as key=value, layered: shared/common.yaml
                                   + shared/<env>.yaml (+ agents/<n> + hires/<n>).
                                   <env> ∈ {common, play, dev, prod}. Bare `export`
                                   (no <env>) is COMMON-ONLY — it never leaks another
                                   env's secrets. Last file wins under shell `eval`.
    list   [<path>]               List secret files, or keys within a file
    import <env-file> <path>      Import a .env file into encrypted storage
    edit   <path>                 Open in $EDITOR via sops (decrypt, edit, re-encrypt)
    age-key export                Print the resolved age identity (for backup/migration)
    age-key import [--from <f>]   Seed the repo identity from a host key (fresh sandbox)
    help                          Show this help

PATHS / ENV LAYERS:
    shared/common.yaml  ALWAYS loaded — env-agnostic shared creds (every consumer)
    shared/play.yaml    local dev sidecar stack (Postgres on `postgres:5432`)
    shared/dev.yaml     staging deploy (dev.decent-cloud.org / dev-api.decent-cloud.org)
    shared/prod.yaml    production deploy (decent-cloud.org / api.decent-cloud.org)
    agents/<name>       Per-agent credentials (overlaid AFTER the env layer)
    hires/<name>        Per-hire credentials (overlaid last; GITHUB_PAT etc.)

FILES:
    secrets/.sops.yaml      SOPS config (commit to git)
    secrets/.age-identity   Private key (NEVER commit — gitignored; portable via env/mount)
    secrets/shared/*.yaml   SOPS-encrypted shared creds, one file per env layer (commit)
    secrets/agents/*.yaml   SOPS-encrypted per-agent creds (commit to git)
    secrets/hires/*.yaml    SOPS-encrypted per-hire creds (commit to git)

ENVIRONMENT (age key resolution, in priority order):
    SOPS_AGE_KEY            Inline age key material (CI / secret manager)
    SOPS_AGE_KEY_FILE       Path to an age identity file (host bind-mount in a sandbox)
    DC_SECRETS_DIR          Override secrets directory (default: <repo>/secrets)
    A fresh clone has no .age-identity; it MUST receive the canonical key via one of the
    two vars above. See agent/docs/secrets.md.

EXAMPLES:
    dc-secrets init
    dc-secrets set shared/common STRIPE_SECRET_KEY=sk_live_...
    dc-secrets set shared/prod API_DATABASE_URL=postgres://...
    dc-secrets get shared/common STRIPE_SECRET_KEY
    dc-secrets export                 # common-only (no env leakage)
    dc-secrets export play            # common + play layer
    dc-secrets export prod --agent agent-1   # common + prod + agent/hire overrides
    dc-secrets age-key export > ~/.config/decent-cloud/age-identity   # make portable
    SOPS_AGE_KEY_FILE=~/.config/decent-cloud/age-identity dc-secrets list shared/prod
"""


def cmd_help() -> None:
    sys.stdout.write(HELP_TEXT)


# ─── Main ─────────────────────────────────────────────────────────────────────
def main() -> None:
    if len(sys.argv) < 2:
        cmd_help()
        sys.exit(1)
    command = sys.argv[1]
    args = sys.argv[2:]
    if command == "init":
        cmd_init(args)
    elif command == "get":
        cmd_get(args)
    elif command == "set":
        cmd_set(args)
    elif command == "delete":
        cmd_delete(args)
    elif command == "export":
        cmd_export(args)
    elif command == "list":
        cmd_list(args)
    elif command == "import":
        cmd_import(args)
    elif command == "edit":
        cmd_edit(args)
    elif command == "age-key":
        cmd_age_key(args)
    elif command in ("help", "--help", "-h"):
        cmd_help()
    else:
        die(f"unknown command: {command}. Run 'dc-secrets help'")


if __name__ == "__main__":
    main()
