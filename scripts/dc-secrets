#!/usr/bin/env bash
# dc-secrets: credential store using SOPS (age backend) with flock concurrency.
# Single source of truth for all credentials. SOPS files are git-committable
# (keys visible, values encrypted). Designed for multi-agent Docker environments.
set -euo pipefail

SECRETS_DIR="${DC_SECRETS_DIR:-$(cd "$(dirname "$0")/.." && pwd)/secrets}"
IDENTITY_FILE="$SECRETS_DIR/.age-identity"
SOPS_CONFIG="$SECRETS_DIR/.sops.yaml"
LOCKS_DIR="$SECRETS_DIR/.locks"
AGE_KEY_SOURCE=""

die() { echo "dc-secrets: error: $*" >&2; exit 1; }

# Resolve the SOPS age key from the first available source, in priority order:
#   1. SOPS_AGE_KEY          inline key material (CI / secret manager). SOPS reads
#                            this natively — no identity file needed.
#   2. SOPS_AGE_KEY_FILE     explicit path (e.g. a host bind-mount in a sandbox).
#   3. $IDENTITY_FILE        repo-local bootstrap file (generated by `init`).
# A fresh clone/sandbox ships encrypted SOPS files but NO key; it must receive the
# canonical age key via (1) or (2). See agent/docs/secrets.md.
# Sets AGE_KEY_SOURCE; exports SOPS_AGE_KEY_FILE when a file source is used.
resolve_age_key() {
    if [[ -n "${SOPS_AGE_KEY:-}" ]]; then
        AGE_KEY_SOURCE="env:SOPS_AGE_KEY"
        unset SOPS_AGE_KEY_FILE   # let SOPS use the inline key
        return 0
    elif [[ -n "${SOPS_AGE_KEY_FILE:-}" && -f "${SOPS_AGE_KEY_FILE}" ]]; then
        AGE_KEY_SOURCE="env:SOPS_AGE_KEY_FILE"
        export SOPS_AGE_KEY_FILE
        return 0
    elif [[ -f "$IDENTITY_FILE" ]]; then
        AGE_KEY_SOURCE="file:$IDENTITY_FILE"
        export SOPS_AGE_KEY_FILE="$IDENTITY_FILE"
        return 0
    fi
    return 1
}
# Best-effort resolution up front so ad-hoc `sops` calls inherit the right env.
resolve_age_key || true

# Derive the age public key (recipient) from whichever identity is resolved.
# Works for both the bare secret (SOPS_AGE_KEY) and a full identity file.
derive_pubkey() {
    if [[ -n "${SOPS_AGE_KEY:-}" ]]; then
        printf '%s\n' "$SOPS_AGE_KEY" | age-keygen -y 2>/dev/null
    elif [[ -n "${SOPS_AGE_KEY_FILE:-}" && -f "${SOPS_AGE_KEY_FILE}" ]]; then
        age-keygen -y "$SOPS_AGE_KEY_FILE" 2>/dev/null
    elif [[ -f "$IDENTITY_FILE" ]]; then
        age-keygen -y "$IDENTITY_FILE" 2>/dev/null
    else
        return 1
    fi
}

# Create $SOPS_CONFIG (idempotent) using the resolved identity's public key.
_ensure_sops_config() {
    [[ -f "$SOPS_CONFIG" ]] && return 0
    local pubkey; pubkey=$(derive_pubkey) || die "could not derive age public key for .sops.yaml"
    cat > "$SOPS_CONFIG" <<YAML
creation_rules:
  - path_regex: \\.yaml\$
    age: $pubkey
YAML
}

require_sops() {
    command -v sops >/dev/null 2>&1 || die "sops not found. Install: https://github.com/getsops/sops"
    command -v age >/dev/null 2>&1 || die "age not found. Install: https://github.com/FiloSottile/age"
}

require_init() {
    resolve_age_key || die "no SOPS age key found. Provide it via one of:
  - SOPS_AGE_KEY env var        inline key material (best for CI / sandbox injection)
  - SOPS_AGE_KEY_FILE env var   path to an age identity file (e.g. a host bind-mount)
  - $IDENTITY_FILE              generated by 'dc-secrets init' on the bootstrap host
A fresh sandbox receives the canonical key via env or a host bind-mount; see
agent/docs/secrets.md. Without it the committed SOPS files cannot be decrypted."
    [[ -f "$SOPS_CONFIG" ]] || die ".sops.yaml missing. Run: dc-secrets init"
}

# Resolve logical path (e.g. "shared/api") to SOPS YAML file
resolve_path() {
  echo "$SECRETS_DIR/$(dirname "${1}")/$(basename "${1}" .yaml).yaml"
}

resolve_lock() {
    local logical="$1"
    local lock_dir="$LOCKS_DIR/$(dirname "$logical")"
    mkdir -p "$lock_dir"
    echo "$lock_dir/$(basename "$logical").lock"
}

# Decrypt a SOPS file, output flat key=value lines (no YAML nesting)
decrypt_flat() {
    local file="$1"
    [[ -f "$file" ]] || return 0
    sops -d "$file" 2>/dev/null | yaml_to_flat
}

# Convert flat YAML (key: value) to key=value, skipping sops metadata
yaml_to_flat() {
    while IFS= read -r line; do
        # Skip blank, comments, sops metadata block
        [[ -z "$line" || "$line" == "#"* || "$line" == "sops:"* ]] && continue
        [[ "$line" == "    "* ]] && continue  # sops metadata indented lines
        # Parse "key: value" → "key=value"
        local key="${line%%:*}"
        local rest="${line#*: }"
        # Handle quoted strings
        rest="${rest#\"}" ; rest="${rest%\"}"
        rest="${rest#\'}" ; rest="${rest%\'}"
        echo "${key}=${rest}"
    done
}

# Create/update a SOPS-encrypted YAML file from key=value pairs on stdin
encrypt_yaml() {
    local file="$1"
    local tmp
    tmp="$(mktemp --suffix=.yaml)"
    mkdir -p "$(dirname "$file")"
    cat > "$tmp"
    sops -e -i --config "$SOPS_CONFIG" "$tmp" 2>/dev/null
    mv "$tmp" "$file"
}

# Build YAML content from key=value lines
flat_to_yaml() {
    while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        local key="${line%%=*}"
        local value="${line#*=}"
        # Escape backslashes and double quotes for valid YAML
        value="${value//\\/\\\\}"
        value="${value//\"/\\\"}"
        printf '%s: "%s"\n' "$key" "$value"
    done
}

# ─── Commands ──────────────────────────────────────────────────────────────────

cmd_init() {
    require_sops
    mkdir -p "$SECRETS_DIR/shared" "$SECRETS_DIR/agents" "$LOCKS_DIR"

    # Footgun guard: if a portable age key is already available (env or host
    # bind-mount), ADOPT it instead of generating a competing local key — a fresh
    # key would be unable to decrypt the committed SOPS files (orphaning them).
    if resolve_age_key >/dev/null 2>&1; then
        _ensure_sops_config
        echo "Adopted existing age key ($AGE_KEY_SOURCE) — no new key generated."
        [[ -f "$SOPS_CONFIG" ]] && echo "SOPS config: $SOPS_CONFIG"
        return 0
    fi

    # Bootstrap (first-time-only, on the host): generate the canonical age key.
    age-keygen -o "$IDENTITY_FILE" >/dev/null 2>&1
    chmod 600 "$IDENTITY_FILE"
    # Now that the repo identity exists, point resolution at it and write .sops.yaml.
    export SOPS_AGE_KEY_FILE="$IDENTITY_FILE"
    AGE_KEY_SOURCE="file:$IDENTITY_FILE"
    _ensure_sops_config

    echo "Initialized secrets store at $SECRETS_DIR"
    echo "Identity: $IDENTITY_FILE (KEEP SECRET — do NOT commit)"
    echo "Recipient: $(derive_pubkey)"
    echo "SOPS config: $SOPS_CONFIG (commit this)"
    echo ""
    echo "Make this key portable across sandboxes:"
    echo "  dc-secrets age-key export > ~/.config/decent-cloud/age-identity"
}

cmd_get() {
    [[ $# -ge 2 ]] || die "usage: dc-secrets get <path> <key>"
    require_sops; require_init
    local file key
    file=$(resolve_path "$1"); key="$2"
    [[ -f "$file" ]] || die "secret file not found: $1"

    local value
    value=$(sops -d --extract "[\"$key\"]" "$file" 2>/dev/null) || die "key not found: $key in $1"
    echo "$value"
}

cmd_set() {
    [[ $# -ge 2 ]] || die "usage: dc-secrets set <path> <key>=<value>"
    require_sops; require_init
    local logical="$1"; shift
    local file lock_file
    file=$(resolve_path "$logical")
    lock_file=$(resolve_lock "$logical")

    (
        flock -w 10 200 || die "could not acquire lock for $logical (timeout 10s)"

        # Decrypt existing content or start fresh
        local content=""
        if [[ -f "$file" ]]; then
            content=$(decrypt_flat "$file") || content=""
        fi

        for kv in "$@"; do
            local key="${kv%%=*}"
            local value="${kv#*=}"
            [[ "$kv" == *=* ]] || die "invalid format: $kv (expected key=value)"

            # Remove existing key, then append
            local new_content=""
            while IFS= read -r line; do
                [[ -z "$line" ]] && continue
                local k="${line%%=*}"
                [[ "$k" == "$key" ]] && continue
                new_content+="$line"$'\n'
            done <<< "$content"
            content="${new_content}${key}=${value}"$'\n'
        done

        echo -n "$content" | flat_to_yaml | encrypt_yaml "$file"

    ) 200>"$lock_file"
}

cmd_delete() {
    [[ $# -ge 2 ]] || die "usage: dc-secrets delete <path> <key>"
    require_sops; require_init
    local logical="$1"; local key="$2"
    local file lock_file
    file=$(resolve_path "$logical")
    lock_file=$(resolve_lock "$logical")
    [[ -f "$file" ]] || die "secret file not found: $logical"

    (
        flock -w 10 200 || die "could not acquire lock for $logical (timeout 10s)"

        local content found=false new_content=""
        content=$(decrypt_flat "$file")
        while IFS= read -r line; do
            [[ -z "$line" ]] && continue
            local k="${line%%=*}"
            if [[ "$k" == "$key" ]]; then
                found=true; continue
            fi
            new_content+="$line"$'\n'
        done <<< "$content"

        [[ "$found" == true ]] || die "key not found: $key in $logical"

        if [[ -z "$new_content" ]]; then
            rm -f "$file"
        else
            echo -n "$new_content" | flat_to_yaml | encrypt_yaml "$file"
        fi

    ) 200>"$lock_file"
}

cmd_export() {
    require_sops; require_init
    local agent=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --agent) agent="$2"; shift 2 ;;
            *) die "unknown flag: $1" ;;
        esac
    done

    # Shared secrets first
    for f in "$SECRETS_DIR"/shared/*.yaml; do
        [[ -f "$f" ]] || continue
        decrypt_flat "$f"
    done

    # Agent-specific overrides
    if [[ -n "$agent" ]]; then
        local agent_file="$SECRETS_DIR/agents/${agent}.yaml"
        if [[ -f "$agent_file" ]]; then
            decrypt_flat "$agent_file"
        fi
    fi
}

cmd_list() {
    require_init
    if [[ $# -eq 0 ]]; then
        find "$SECRETS_DIR" -name '*.yaml' -not -name '.sops.yaml' -printf '%P\n' | sed 's/\.yaml$//' | sort
    else
        require_sops
        local file
        file=$(resolve_path "$1")
        [[ -f "$file" ]] || die "secret file not found: $1"
        # List keys from SOPS file (encrypted keys are visible without decryption)
        sops -d "$file" 2>/dev/null | yaml_to_flat | while IFS= read -r line; do
            [[ -z "$line" ]] && continue
            echo "${line%%=*}"
        done
    fi
}

cmd_import() {
    [[ $# -ge 2 ]] || die "usage: dc-secrets import <env-file> <path>"
    require_sops; require_init
    local env_file="$1" logical="$2"
    [[ -f "$env_file" ]] || die "file not found: $env_file"

    local file lock_file
    file=$(resolve_path "$logical")
    lock_file=$(resolve_lock "$logical")

    # Parse env file outside subshell so we can report count
    local content=""
    while IFS= read -r line; do
        [[ -z "$line" || "$line" == \#* ]] && continue
        line="${line#export }"
        [[ "$line" == *=* ]] || continue
        # Strip surrounding quotes from value
        local key="${line%%=*}"
        local value="${line#*=}"
        value="${value#\"}" ; value="${value%\"}"
        value="${value#\'}" ; value="${value%\'}"
        content+="${key}=${value}"$'\n'
    done < "$env_file"

    [[ -n "$content" ]] || die "no key=value pairs found in $env_file"

    (
        flock -w 10 200 || die "could not acquire lock for $logical (timeout 10s)"
        echo -n "$content" | flat_to_yaml | encrypt_yaml "$file"
    ) 200>"$lock_file"

    local count
    count=$(echo -n "$content" | grep -c '=')
    echo "Imported $count keys into $logical"
}

cmd_edit() {
    [[ $# -ge 1 ]] || die "usage: dc-secrets edit <path>"
    require_sops; require_init
    local file
    file=$(resolve_path "$1")
    [[ -f "$file" ]] || die "secret file not found: $1 (create it first with 'set' or 'import')"
    sops "$file"
}

cmd_age_key() {
    local sub="${1:-}"; shift || true
    case "$sub" in
        export)
            # Print the resolved age identity so it can be backed up / copied to a
            # host canonical location for portability across sandboxes/hosts.
            require_init
            if [[ -n "${SOPS_AGE_KEY:-}" ]]; then
                printf '%s\n' "$SOPS_AGE_KEY"
            elif [[ -n "${SOPS_AGE_KEY_FILE:-}" && -f "${SOPS_AGE_KEY_FILE}" ]]; then
                cat "$SOPS_AGE_KEY_FILE"
            elif [[ -f "$IDENTITY_FILE" ]]; then
                cat "$IDENTITY_FILE"
            else
                die "no age key available to export"
            fi
            ;;
        import)
            # Seed the repo-local identity from a host-provided key (fresh sandbox).
            # Usage: dc-secrets age-key import [--from <path>]   (default: stdin)
            local from="-"
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --from) from="$2"; shift 2 || die "age-key import: --from requires a path" ;;
                    *) die "age-key import: unknown argument: $1" ;;
                esac
            done
            require_sops
            mkdir -p "$SECRETS_DIR"
            if [[ -f "$IDENTITY_FILE" ]]; then
                die "$IDENTITY_FILE already exists. To replace it, delete the file first (WARNING: this orphans files encrypted to the old key)."
            fi
            local tmp; tmp=$(mktemp)
            if [[ "$from" == "-" ]]; then
                cat > "$tmp"
            else
                [[ -f "$from" ]] || { rm -f "$tmp"; die "file not found: $from"; }
                cat "$from" > "$tmp"
            fi
            # Validate it looks like an age identity before trusting it.
            grep -q '^AGE-SECRET-KEY-1' "$tmp" || { rm -f "$tmp"; die "imported key is not a valid age identity (expected a line starting with AGE-SECRET-KEY-1)"; }
            chmod 600 "$tmp"
            mv "$tmp" "$IDENTITY_FILE"
            # Derive recipient + write .sops.yaml (init's adoption path picks this up too).
            export SOPS_AGE_KEY_FILE="$IDENTITY_FILE"
            _ensure_sops_config
            echo "Imported age identity into $IDENTITY_FILE"
            echo "Recipient: $(derive_pubkey)"
            ;;
        *)
            die "usage: dc-secrets age-key <export|import [--from <path>]>"
            ;;
    esac
}

cmd_help() {
    cat <<'EOF'
dc-secrets: credential store using SOPS (age encryption)

USAGE:
    dc-secrets <command> [args...]

COMMANDS:
    init                          Initialize store (generate age keypair + .sops.yaml),
                                  or ADOPT a portable key already provided via env/mount
    get    <path> <key>           Read a single credential
    set    <path> <key>=<value>   Write one or more credentials (flock-protected)
    delete <path> <key>           Remove a credential
    export [--agent <name>]       Print all shared (+ agent-specific) creds as key=value
    list   [<path>]               List secret files, or keys within a file
    import <env-file> <path>      Import a .env file into encrypted storage
    edit   <path>                 Open in $EDITOR via sops (decrypt, edit, re-encrypt)
    age-key export                Print the resolved age identity (for backup/migration)
    age-key import [--from <f>]   Seed the repo identity from a host key (fresh sandbox)
    help                          Show this help

PATHS:
    shared/<name>       Shared credentials (all agents)
    agents/<name>       Per-agent credentials

FILES:
    secrets/.sops.yaml      SOPS config (commit to git)
    secrets/.age-identity   Private key (NEVER commit — gitignored; portable via env/mount)
    secrets/shared/*.yaml   SOPS-encrypted shared creds (commit to git)
    secrets/agents/*.yaml   SOPS-encrypted per-agent creds (commit to git)

ENVIRONMENT (age key resolution, in priority order):
    SOPS_AGE_KEY            Inline age key material (CI / secret manager)
    SOPS_AGE_KEY_FILE       Path to an age identity file (host bind-mount in a sandbox)
    DC_SECRETS_DIR          Override secrets directory (default: <repo>/secrets)
    A fresh clone has no .age-identity; it MUST receive the canonical key via one of the
    two vars above. See agent/docs/secrets.md.

EXAMPLES:
    dc-secrets init
    dc-secrets set shared/env STRIPE_SECRET_KEY=sk_test_...
    dc-secrets get shared/env STRIPE_SECRET_KEY
    dc-secrets export --agent agent-1
    dc-secrets age-key export > ~/.config/decent-cloud/age-identity   # make portable
    SOPS_AGE_KEY_FILE=~/.config/decent-cloud/age-identity dc-secrets list shared/env
EOF
}

# ─── Main ──────────────────────────────────────────────────────────────────────

[[ $# -ge 1 ]] || { cmd_help; exit 1; }
command="$1"; shift
case "$command" in
    init)     cmd_init "$@" ;;
    get)      cmd_get "$@" ;;
    set)      cmd_set "$@" ;;
    delete)   cmd_delete "$@" ;;
    export)   cmd_export "$@" ;;
    list)     cmd_list "$@" ;;
    import)   cmd_import "$@" ;;
    edit)     cmd_edit "$@" ;;
    age-key)  cmd_age_key "$@" ;;
    help|--help|-h) cmd_help ;;
    *)        die "unknown command: $command. Run 'dc-secrets help'" ;;
esac
