  "query": "SELECT id,\n                      amount_e9s,\n                      balance_after_e9s,\n                      entry_type,\n                      reference,\n                      COALESCE(EXTRACT(EPOCH FROM created_at)::BIGINT, 0) as \"created_at!: i64\"\n               FROM wallet_ledger\n               WHERE pubkey = $1\n               ORDER BY created_at DESC\n               LIMIT $2",
