# Development/staging API endpoint
# Used when building the website for dev/staging Docker deployment
# Browser will connect to API at this URL
VITE_DECENT_CLOUD_API_URL=http://localhost:59011

# Stripe API publishable key (for frontend)
# Get your test keys from https://dashboard.stripe.com/test/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Chatwoot widget configuration (optional — leave BOTH blank to disable)
# When either is unset the widget renders nothing (no script/iframe, no console
# errors). Set BOTH to enable the support chat:
#   - VITE_CHATWOOT_BASE_URL: public URL of your Chatwoot instance (the host that
#     serves /packs/js/sdk.js), e.g. https://dev-support.decent-cloud.org
#   - VITE_CHATWOOT_WEBSITE_TOKEN: the "Website Token" from the Chatwoot inbox
# At deploy time cf/deploy.py maps these from CHATWOOT_BASE_URL /
# CHATWOOT_WEBSITE_TOKEN; the CI release workflow maps them from the GitHub
# `CHATWOOT_BASE_URL` repo variable / `CHATWOOT_WEBSITE_TOKEN` Actions secret.
VITE_CHATWOOT_WEBSITE_TOKEN=
VITE_CHATWOOT_BASE_URL=

# Telegram bot username (without @)
# Dev: DecentCloudDevBot, Prod: DecentCloudBot
VITE_TELEGRAM_BOT_USERNAME=DecentCloudBot
